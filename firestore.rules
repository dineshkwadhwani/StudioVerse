rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function currentUserType() {
      return currentUserExists() ? currentUser().userType : null;
    }

    function currentTenantId() {
      return currentUserExists() ? currentUser().tenantId : null;
    }

    function currentCompanyId() {
      return currentUserExists() ? currentUser().associatedCompanyId : null;
    }

    function isSuperAdmin() {
      return isSignedIn()
        && (
             request.auth.token.get('superadmin', false) == true
             || (currentUserExists() && currentUser().userType == "superadmin")
           );
    }

    // Bootstrap escape-hatch: lets the master SA create their own users/{uid} doc
    // after a DB wipe — isSuperAdmin() would be false (no doc yet, no claim yet).
    function isMasterSuperadminPhone() {
      return isSignedIn()
        && request.auth.token.get('phone_number', '') == "+919767676738";
    }

    function isCompanyUser() {
      return isSignedIn() && currentUserType() == "company";
    }

    function isProfessionalUser() {
      return isSignedIn() && currentUserType() == "professional";
    }

    // ── Users ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isSignedIn();
      allow create: if isSuperAdmin()
                    || (isSignedIn() && request.auth.uid == userId)
                    || isMasterSuperadminPhone();
      allow update: if isSuperAdmin()
                    || (isSignedIn() && request.auth.uid == userId)
                    || (isSignedIn() && request.auth.uid == resource.data.uid)
                    || (isCompanyUser() && resource.data.associatedCompanyId == request.auth.uid)
                    || (isCompanyUser()
                        && resource.data.userType in ["professional", "individual"]
                        && resource.data.tenantId == currentTenantId()
                        && resource.data.get('associatedCompanyId', null) == null)
                    || (isCompanyUser()
                        && resource.data.userType == "individual"
                        && resource.data.tenantId == currentTenantId()
                        && resource.data.associatedCompanyId == request.auth.uid)
                    || (isProfessionalUser() && resource.data.associatedProfessionalId == request.auth.uid)
                    || (isProfessionalUser()
                        && resource.data.userType == "individual"
                        && resource.data.tenantId == currentTenantId()
                        && resource.data.get('associatedProfessionalId', null) == null);
      allow delete: if false;
    }

    // ── Invitations ────────────────────────────────────────────────────────
    // Pre-created users live here until claimed. Claimed by Cloud Function.
    match /invitations/{invitationId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSuperAdmin() || isSignedIn();
      allow delete: if false;
    }

    // ── Tenants ────────────────────────────────────────────────────────────
    match /tenants/{tenantId} {
      allow read:  if true;
      allow write: if isSuperAdmin();
    }

    // ── Wallets ────────────────────────────────────────────────────────────
    // Wallet IDs may be scoped: {tenantId}_{userId} or plain userId.
    // Users can read/update their own wallet (matched by userId field).
    // Company users can also update wallets of their associated professionals.
    // ── Wallets ────────────────────────────────────────────────────────────
    // Wallet IDs are scoped: {tenantId}_{userId}.
    match /wallets/{walletId} {
      allow read:   if isSuperAdmin()
                    || (isSignedIn() && resource.data.userId == request.auth.uid)
                    || (isCompanyUser() &&
                         get(/databases/$(database)/documents/users/$(resource.data.userId)).data.associatedCompanyId == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isSuperAdmin()
                    || (isSignedIn() && resource.data.userId == request.auth.uid)
                    || (isCompanyUser() &&
                         get(/databases/$(database)/documents/users/$(resource.data.userId)).data.associatedCompanyId == request.auth.uid);
      allow delete: if false;
    }

    // ── Wallet Transactions ────────────────────────────────────────────────
    match /walletTransactions/{txId} {
      allow read:   if isSuperAdmin()
                    || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isSuperAdmin();
      allow delete: if false;
    }

    // ── Assessments ────────────────────────────────────────────────────────
    match /assessments/{assessmentId} {
      allow read:  if true;
      allow write: if isSuperAdmin() || isSignedIn();
    }

    // ── Assessment Questions ───────────────────────────────────────────────
    match /assessmentQuestions/{questionId} {
      allow read:   if isSignedIn();
      allow write:  if isSuperAdmin();
    }

    // ── Assessment Attempts ────────────────────────────────────────────────
    match /assessmentAttempts/{attemptId} {
      allow read:   if isSuperAdmin()
                    || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isSuperAdmin()
                    || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if false;
    }

    // ── Assessment Reports ─────────────────────────────────────────────────
    match /assessmentReports/{reportId} {
      allow read:   if isSuperAdmin()
                    || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isSuperAdmin();
      allow delete: if false;
    }

    // ── Programs ──────────────────────────────────────────────────────────
    match /programs/{programId} {
      allow read:  if true;
      allow write: if isSuperAdmin() || isSignedIn();
    }

    // ── Events ────────────────────────────────────────────────────────────
    match /events/{eventId} {
      allow read:  if true;
      allow write: if isSuperAdmin() || isSignedIn();
    }

    // ── Assignments ────────────────────────────────────────────────────────
    match /assignments/{assignmentId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSuperAdmin()
                    || (isSignedIn() && (
                         resource.data.assignedTo  == request.auth.uid ||
                         resource.data.assignedBy  == request.auth.uid ||
                         resource.data.assignerId  == request.auth.uid ||
                         resource.data.assigneeId  == request.auth.uid
                       ));
      allow delete: if false;
    }

    // ── Cohorts ────────────────────────────────────────────────────────────
    match /cohorts/{cohortId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSuperAdmin() || isSignedIn();
      allow delete: if isSuperAdmin();
    }

    // ── Cohort Members ─────────────────────────────────────────────────────
    // saveCohort deletes + re-creates members from the client.
    match /cohortMembers/{memberId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSuperAdmin()
            || (isCompanyUser() && resource.data.companyId == request.auth.uid)
            || (isProfessionalUser() && resource.data.professionalId == request.auth.uid);
      allow delete: if isSuperAdmin()
            || (isCompanyUser() && (
                resource.data.companyId == request.auth.uid
                || resource.data.get('companyId', null) == null))
            || (isProfessionalUser() && resource.data.professionalId == request.auth.uid)
            || (isSignedIn() && resource.data.addedByUserId == request.auth.uid);
    }

    // ── Cohort Assignments ─────────────────────────────────────────────────
    match /cohortAssignments/{cohortAssignmentId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSuperAdmin() || isSignedIn();
      allow delete: if isSuperAdmin();
    }

    // ── Referrals ──────────────────────────────────────────────────────────
    match /referrals/{referralId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSuperAdmin();
    }

    // ── Coin Requests ──────────────────────────────────────────────────────
    match /coinRequests/{requestId} {
      allow create: if isProfessionalUser()
        && request.resource.data.requesterProfessionalId == request.auth.uid
        && request.resource.data.tenantId == currentTenantId()
        && request.resource.data.companyId == currentCompanyId()
        && request.resource.data.status == "pending"
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;

      allow read: if isSuperAdmin()
        || (isSignedIn() && (
              resource.data.requesterProfessionalId == request.auth.uid ||
              resource.data.companyId == request.auth.uid ||
              (isCompanyUser() && resource.data.companyId == currentCompanyId())
           ));

      allow update: if isSuperAdmin()
        || (isCompanyUser()
            && (resource.data.companyId == currentCompanyId() || resource.data.companyId == request.auth.uid)
            && resource.data.status == "pending"
            && request.resource.data.status in ["approved", "denied"]
            && request.resource.data.requesterProfessionalId == resource.data.requesterProfessionalId
            && request.resource.data.companyId == resource.data.companyId
            && request.resource.data.tenantId == resource.data.tenantId
            && request.resource.data.amount == resource.data.amount);

      allow delete: if false;
    }

    // ── Coin Packages ──────────────────────────────────────────────────────
    match /coinPackages/{packageId} {
      allow read:   if true;
      allow write:  if isSuperAdmin();
    }

    // ── Earning Packages ───────────────────────────────────────────────────
    // Unified reference data for all earning-related packages (Credit, Listing, Bot)
    // per tenant. Scoped by tenantId document path.
    match /earningPackages/{tenantId} {
      allow read:   if isSignedIn();
      allow write:  if isSuperAdmin();
    }

    // ── Categories ─────────────────────────────────────────────────────────
    // Platform-wide taxonomy used by Programs, Events, and Assessments.
    match /categories/{categoryId} {
      allow read:   if isSignedIn();
      allow write:  if isSuperAdmin();
    }

    // ── Sub Categories ─────────────────────────────────────────────────────
    // Child taxonomy records linked to categories by categoryId.
    match /subCategories/{subCategoryId} {
      allow read:   if isSignedIn();
      allow write:  if isSuperAdmin();
    }

    // ── Topics ─────────────────────────────────────────────────────────────
    // Third-tier taxonomy records linked to subCategories and categories.
    match /topics/{topicId} {
      allow read:   if isSignedIn();
      allow write:  if isSuperAdmin();
    }

    // ── Languages ──────────────────────────────────────────────────────────
    // Reference data: language codes and names used by Programs, Events, Assessments.
    match /languages/{languageId} {
      allow read:   if isSignedIn();
      allow write:  if isSuperAdmin();
    }

    // ── Coin Orders ────────────────────────────────────────────────────────
    match /coinOrders/{orderId} {
      allow read:   if isSuperAdmin()
                    || (isSignedIn() && (
                         resource.data.userId    == request.auth.uid ||
                         resource.data.createdBy == request.auth.uid
                       ));
      allow create: if isSignedIn();
      allow update: if isSuperAdmin()
                    || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if false;
    }

    // ── Promotion Packages ─────────────────────────────────────────────────
    match /promotionPackages/{packageId} {
      allow read:   if isSignedIn();
      allow write:  if isSuperAdmin();
    }

    // ── Listing Packages ───────────────────────────────────────────────────
    match /listingPackages/{packageId} {
      allow read:   if isSignedIn();
      allow write:  if isSuperAdmin();
    }

    // ── Program Promotion Requests ─────────────────────────────────────────
    match /programPromotionRequests/{requestId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSuperAdmin() || isSignedIn();
      allow delete: if isSuperAdmin();
    }

    // ── Bot Hero Requests ──────────────────────────────────────────────────
    match /botHeroRequests/{requestId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSuperAdmin() || isSignedIn();
      allow delete: if isSuperAdmin();
    }

    // ── Bot Hero Packages ─────────────────────────────────────────────────
    match /botHeroPackages/{packageId} {
      allow read:   if isSignedIn();
      allow write:  if isSuperAdmin();
    }

    // ── Cashout Requests ───────────────────────────────────────────────────
    match /cashoutRequests/{requestId} {
      allow read:   if isSuperAdmin()
                    || (isSignedIn() && resource.data.requesterUserId == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isSuperAdmin();
      allow delete: if false;
    }

    // ── Bot Knowledge ──────────────────────────────────────────────────────
    match /bot-knowledge/{docId} {
      allow read:  if true;
      allow write: if isSuperAdmin();
    }

    // ── Notification Logs ──────────────────────────────────────────────────
    // Client services log notification outcomes; superadmin reads for audit.
    match /notificationLogs/{logId} {
      allow read:   if isSuperAdmin();
      allow create: if request.auth != null;
    }

    // ── Audit Logs ─────────────────────────────────────────────────────────
    // Written by Cloud Functions (admin SDK). Superadmin reads only.
    match /auditLogs/{logId} {
      allow read:  if isSuperAdmin();
      allow write: if false;
    }

    // ── Guest Logs ─────────────────────────────────────────────────────────
    match /guestLogs/{logId} {
      allow read:  if isSuperAdmin();
      allow create: if true;
      allow update: if false;
      allow delete: if false;
    }

    // ── Lead Unlocks ───────────────────────────────────────────────────────
    match /leadUnlocks/{unlockId} {
      allow read:   if isSuperAdmin() || isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSuperAdmin();
      allow delete: if false;
    }

    // ── Messages ──────────────────────────────────────────────────────────
    match /messages/{messageId} {
      allow read:   if isSignedIn()
                    && (resource.data.senderUserId == request.auth.uid
                        || resource.data.receiverUserId == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isSignedIn()
                    && resource.data.receiverUserId == request.auth.uid
                    && request.resource.data.responseType in ["ignore", "interested"];
      allow delete: if false;
    }

  }
}
